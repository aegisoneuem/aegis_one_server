# Aegis One end-to-end test environment (docs/e2e-testing.md).
# Copy to /opt/aegis-e2e/e2e.env on the Ubuntu box, fill in, then: chmod 600 e2e.env
# Never commit the filled-in copy.

# Ubuntu server address as the Windows test VM reaches it
E2E_SERVER_IP=<UBUNTU_IP>

# Postgres: the owner login runs migrations, the app login runs the server
E2E_PG_OWNER_URL=postgres://postgres:<PG_PASSWORD>@localhost:5432/aegis_e2e
AEGIS_DATABASE_URL=postgres://aegis_e2e_app:<APP_PASSWORD>@localhost:5432/aegis_e2e

# Passphrases (16+ characters each) for the enrollment CA key and the secrets key
AEGIS_CA_KEY_PASSPHRASE=<CA_PASSPHRASE>
AEGIS_SECRETS_KEY_PASSPHRASE=<SECRETS_PASSPHRASE>

# Server files (paths relative to /opt/aegis-e2e)
AEGIS_CA_CERT=certs/ca.crt
AEGIS_CA_KEY_FILE=certs/ca.key.enc
AEGIS_TLS_CERT=certs/server.crt
AEGIS_TLS_KEY=certs/server.key
AEGIS_TLS_CA=certs/ca.crt
AEGIS_COMMAND_SIGNING_KEY_FILE=secrets/command_signing.key
AEGIS_SECRETS_KEY_FILE=secrets/secrets.key.enc
AEGIS_CONTENT_DIR=content

# off = no internet needed (no MSRC feed / scan cab download)
AEGIS_FEED_SCHEDULER=on
AEGIS_CAB_MANIFEST=on
AEGIS_LOG_LEVEL=info
